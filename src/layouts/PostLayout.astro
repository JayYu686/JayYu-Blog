---
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl } from '../i18n/utils';

type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & {
    readingTime?: string;
    headings?: Heading[];
    previousPost?: CollectionEntry<'blog'>;
    nextPost?: CollectionEntry<'blog'>;
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    readingTime,
    headings = [],
    previousPost,
    nextPost,
    tags = [],
    category,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';
const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const updatedLabel = lang === 'zh' ? '更新于：' : 'Updated: ';
const blogPath = lang === 'zh' ? '/blog' : `/${lang}/blog`;
const tocItems = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const labels = lang === 'zh'
    ? { toc: '文章目录', previous: '上一篇', next: '下一篇', older: '更早的文章', newer: '更新的文章', close: '关闭图片', copy: '复制代码' }
    : { toc: 'Table of contents', previous: 'Previous article', next: 'Next article', older: 'Older article', newer: 'Newer article', close: 'Close image', copy: 'Copy code' };
---

<BaseLayout title={title} description={description} image={heroImage || '/cover.webp'}>
    <div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>
    <article class="post-container">
        <header class="post-header">
            <h1 class="post-title">{title}</h1>
            <div class="post-meta">
                <span><span class="meta-icon" aria-hidden="true">📅</span> <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(dateLocale, dateOptions)}</time></span>
                {readingTime && <span class="reading-time"><span class="meta-icon" aria-hidden="true">⏱</span> {readingTime}</span>}
                {updatedDate && (
                    <span class="updated-date">
                        ({updatedLabel}<time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString(dateLocale, dateOptions)}</time>)
                    </span>
                )}
            </div>
            {(category || tags.length > 0) && (
                <div class="post-taxonomy">
                    {category && <span class="post-category">{category}</span>}
                    {tags.map((tag) => <a href={`${blogPath}?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}
                </div>
            )}
            <div class="hero-image-wrapper">
                <img src={heroImage || '/cover.webp'} onerror="this.onerror=null;this.src='/cover.webp';" alt={title} class="hero-image" loading="eager" decoding="async" />
            </div>
        </header>

        {tocItems.length > 0 && (
            <details class="post-toc" open>
                <summary>{labels.toc}</summary>
                <nav aria-label={labels.toc}>
                    <ol>
                        {tocItems.map((heading) => (
                            <li class:list={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
                        ))}
                    </ol>
                </nav>
            </details>
        )}

        <div class="post-content">
            <slot />
        </div>

        {(previousPost || nextPost) && (
            <nav class="post-pagination" aria-label={lang === 'zh' ? '文章导航' : 'Article navigation'}>
                {previousPost ? (
                    <a href={`${blogPath}/${previousPost.id}`} class="post-nav-link post-nav-previous">
                        <span>{labels.previous} · {labels.older}</span>
                        <strong>← {previousPost.data.title}</strong>
                    </a>
                ) : <span></span>}
                {nextPost && (
                    <a href={`${blogPath}/${nextPost.id}`} class="post-nav-link post-nav-next">
                        <span>{labels.next} · {labels.newer}</span>
                        <strong>{nextPost.data.title} →</strong>
                    </a>
                )}
            </nav>
        )}

        <div class="post-footer">
            <a href={blogPath} class="back-link">cd ../</a>
        </div>
    </article>

    <dialog class="image-lightbox" data-image-lightbox aria-label={labels.close}>
        <button type="button" data-lightbox-close aria-label={labels.close}>×</button>
        <img data-lightbox-image alt="" />
    </dialog>
</BaseLayout>

<script>
    let cleanupReadingProgress = () => {};

    const initPostEnhancements = () => {
        cleanupReadingProgress();
        const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
        const content = document.querySelector<HTMLElement>('.post-content');
        const updateProgress = () => {
            if (!progress || !content) return;
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const ratio = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
            progress.style.setProperty('--reading-progress', `${ratio * 100}%`);
        };
        if (progress) {
            window.addEventListener('scroll', updateProgress, { passive: true });
            updateProgress();
            cleanupReadingProgress = () => window.removeEventListener('scroll', updateProgress);
        }

        const lightbox = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
        const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
        const closeLightbox = () => lightbox?.close();
        content?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
            if (image.dataset.zoomBound) return;
            image.dataset.zoomBound = 'true';
            image.tabIndex = 0;
            image.setAttribute('role', 'button');
            image.setAttribute('aria-label', document.documentElement.lang === 'zh' ? '点击放大图片' : 'Open image');
            const open = () => {
                if (!lightbox || !lightboxImage) return;
                lightboxImage.src = image.currentSrc || image.src;
                lightboxImage.alt = image.alt;
                lightbox.showModal();
            };
            image.addEventListener('click', open);
            image.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    open();
                }
            });
        });
        lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
        lightbox?.addEventListener('click', (event) => {
            if (event.target === lightbox) closeLightbox();
        });
    };

    document.addEventListener('astro:page-load', initPostEnhancements);
    initPostEnhancements();
</script>

<style>
    .reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 200;
        width: 100%;
        height: 3px;
        pointer-events: none;
        background: transparent;
    }

    .reading-progress span {
        display: block;
        width: var(--reading-progress, 0%);
        height: 100%;
        background: var(--accent-color);
        box-shadow: 0 0 8px var(--accent-color);
        transition: width 0.08s linear;
    }

    .post-container {
        margin-top: 40px;
    }

    .post-header {
        margin-bottom: 32px;
        padding-bottom: 20px;
        border-bottom: 1px dashed var(--border-color);
    }

    .post-title {
        margin-bottom: 15px;
        color: var(--accent-color);
        font-size: 2.5rem;
    }

    .post-title::before {
        content: '# ';
        color: var(--text-color);
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 15px;
        margin-bottom: 12px;
        color: var(--secondary-text);
        font-size: 0.95rem;
    }

    .post-taxonomy,
    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        color: var(--secondary-text);
        font-size: 0.85rem;
        font-family: var(--font-mono);
    }

    .post-taxonomy a {
        color: var(--link-color);
        text-decoration: none;
    }

    .post-category {
        color: var(--accent-color);
    }

    .hero-image-wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 16px;
        margin-top: 18px;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
    }

    .hero-image:hover {
        transform: scale(1.02);
    }

    .post-toc {
        margin: 0 0 38px;
        padding: 15px 18px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--code-bg);
    }

    .post-toc summary {
        color: var(--accent-color);
        cursor: pointer;
        font-family: var(--font-mono);
        font-weight: bold;
    }

    .post-toc nav {
        margin-top: 12px;
    }

    .post-toc ol {
        margin: 0;
        padding-left: 20px;
    }

    .post-toc li {
        margin: 7px 0;
    }

    .post-toc .toc-depth-3 {
        margin-left: 18px;
        font-size: 0.92em;
    }

    .post-toc a {
        color: var(--secondary-text);
        text-decoration: none;
    }

    .post-toc a:hover {
        color: var(--accent-color);
    }

    .post-content {
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .post-content :global(h2),
    .post-content :global(h3),
    .post-content :global(h4) {
        margin-top: 2em;
        margin-bottom: 1em;
        color: var(--accent-color);
        scroll-margin-top: 20px;
    }

    .post-content :global(h2)::before {
        content: '## ';
        color: var(--text-color);
    }

    .post-content :global(a) {
        color: var(--link-color);
        border-bottom: 1px dashed var(--link-color);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .post-content :global(a:hover) {
        background-color: rgba(88, 166, 255, 0.1);
        border-bottom-style: solid;
    }

    .post-content :global(img) {
        max-width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        margin: 20px 0;
        cursor: zoom-in;
    }

    .post-content :global(hr) {
        border: none;
        border-top: 1px dashed var(--border-color);
        margin: 40px 0;
    }

    .post-content :global(blockquote) {
        margin: 20px 0;
        padding: 10px 20px;
        border-left: 4px solid var(--accent-color);
        border-radius: 0 4px 4px 0;
        background-color: var(--code-bg);
        color: var(--text-color);
    }

    .post-content :global(pre) {
        margin: 20px 0;
    }

    .post-content :global(ul) {
        padding-left: 20px;
    }

    .post-content :global(li) {
        margin-bottom: 10px;
    }

    .post-pagination {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        margin-top: 55px;
    }

    .post-nav-link {
        display: grid;
        gap: 8px;
        min-width: 0;
        padding: 15px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--accent-color);
        text-decoration: none;
    }

    .post-nav-link span {
        color: var(--secondary-text);
        font-size: 0.8rem;
        font-family: var(--font-mono);
    }

    .post-nav-link strong {
        overflow: hidden;
        color: var(--text-color);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .post-nav-next {
        text-align: right;
    }

    .post-footer {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px dashed var(--border-color);
    }

    .back-link {
        color: var(--accent-color);
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
    }

    .image-lightbox {
        width: min(92vw, 1200px);
        max-width: none;
        padding: 45px 20px 20px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-color);
    }

    .image-lightbox::backdrop {
        background: rgba(0, 0, 0, 0.82);
    }

    .image-lightbox img {
        display: block;
        width: 100%;
        max-height: 80vh;
        object-fit: contain;
    }

    .image-lightbox button {
        position: absolute;
        top: 8px;
        right: 12px;
        border: 0;
        background: transparent;
        color: var(--text-color);
        cursor: pointer;
        font-size: 2rem;
        line-height: 1;
    }

    @media (max-width: 650px) {
        .post-title {
            font-size: 2rem;
        }

        .post-pagination {
            grid-template-columns: 1fr;
        }

        .post-nav-next {
            text-align: left;
        }
    }
</style>
