---
import type { CollectionEntry } from 'astro:content';

interface Props {
    post: CollectionEntry<'blog'>;
    lang: 'zh' | 'en';
    blogBasePath: string;
}

const { post, lang, blogBasePath } = Astro.props;
const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';
const dateOptions: Intl.DateTimeFormatOptions = lang === 'zh'
    ? { year: 'numeric', month: '2-digit', day: '2-digit' }
    : { year: 'numeric', month: 'short', day: 'numeric' };
const formattedDate = lang === 'zh'
    ? post.data.pubDate.toLocaleDateString(dateLocale, dateOptions).replace(/\//g, '-')
    : post.data.pubDate.toLocaleDateString(dateLocale, dateOptions);
const taxonomy = [post.data.title, post.data.description, post.data.category || '', ...post.data.tags].join(' ').toLocaleLowerCase();
---

<article class="post-item" data-post-search={taxonomy}>
    <a href={`${blogBasePath}/${post.id}`} class="post-link">
        <div class="post-info">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            {post.data.category && <span class="post-category">{post.data.category}</span>}
            <h2>{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
                <div class="post-tags" aria-label={lang === 'zh' ? '文章标签' : 'Article tags'}>
                    {post.data.tags.map((tag) => <span>#{tag}</span>)}
                </div>
            )}
        </div>
        <div class="post-thumbnail">
            <img src={post.data.heroImage || '/cover.webp'} onerror="this.onerror=null;this.src='/cover.webp';" alt="" loading="lazy" decoding="async" />
        </div>
    </a>
</article>

<style>
    .post-item {
        background-color: transparent;
        border-left: 2px solid transparent;
        padding: 20px;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .post-item:hover {
        border-left-color: var(--accent-color);
        background-color: var(--code-bg);
        box-shadow: 0 0 15px rgba(88, 166, 255, 0.08), 0 0 30px rgba(88, 166, 255, 0.04);
    }

    .post-link {
        display: flex;
        flex-direction: column;
        gap: 20px;
        text-decoration: none;
        color: inherit;
    }

    @media (min-width: 600px) {
        .post-link {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .post-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 8px;
    }

    .post-date,
    .post-category {
        color: var(--secondary-text);
        font-size: 0.9rem;
        font-family: var(--font-mono);
    }

    .post-category {
        color: var(--accent-color);
        font-size: 0.78rem;
    }

    .post-info h2 {
        margin: 0;
        font-size: 1.3rem;
        color: var(--text-color);
        transition: color 0.2s ease;
    }

    .post-item:hover .post-info h2 {
        color: var(--accent-color);
    }

    .post-desc {
        margin: 0;
        color: var(--secondary-text);
        font-size: 0.95rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: var(--secondary-text);
        font-size: 0.8rem;
        font-family: var(--font-mono);
    }

    .post-thumbnail {
        width: 100%;
        max-width: 240px;
        flex-shrink: 0;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        display: none;
    }

    @media (min-width: 600px) {
        .post-thumbnail {
            display: block;
        }
    }

    .post-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .post-item:hover .post-thumbnail img {
        transform: scale(1.05);
    }
</style>
