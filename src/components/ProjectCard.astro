---
import type { Project } from '../data/projects';

interface Props {
    project: Project;
    lang: 'zh' | 'en';
}

const { project, lang } = Astro.props;
const description = project.desc[lang];
const detailUrl = lang === 'zh' ? `/projects/${project.slug}` : `/en/projects/${project.slug}`;
---

<a
    href={detailUrl}
    class="project-card"
    data-project-card
    data-language={project.lang}
    data-type={project.type}
>
    <div class="card-header">
        <div>
            <span class="project-type">{project.type}</span>
            <h2>{project.name}</h2>
        </div>
        <span class="external-link" aria-hidden="true">↗</span>
    </div>
    <p class="desc">{description}</p>
    <div class="card-footer">
        <span class="lang"><span class="lang-dot"></span>{project.lang}</span>
        <span class="stats">★ {project.stars} · Fork {project.forks}</span>
    </div>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 170px;
        padding: 20px;
        background-color: var(--code-bg);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        color: var(--text-color);
    }

    .project-card:hover {
        border-color: var(--accent-color);
        transform: translateY(-2px);
        text-decoration: none;
        box-shadow: 0 0 15px rgba(88, 166, 255, 0.1), 0 0 30px rgba(88, 166, 255, 0.05);
    }

    .card-header h2 {
        margin: 4px 0 0;
        color: var(--accent-color);
        font-size: 1.2rem;
    }

    .card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .project-type {
        color: var(--secondary-text);
        font-size: 0.75rem;
        font-family: var(--font-mono);
        letter-spacing: 0.04em;
    }

    .external-link {
        color: var(--secondary-text);
        font-family: var(--font-mono);
        font-size: 1.1rem;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .project-card:hover .external-link {
        color: var(--accent-color);
        transform: translate(2px, -2px);
    }

    .desc {
        font-size: 0.95rem;
        margin: 0 0 20px;
        flex-grow: 1;
        color: var(--secondary-text);
        line-height: 1.6;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        font-size: 0.85rem;
        color: var(--secondary-text);
    }

    .lang-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #f1e05a;
        margin-right: 4px;
        vertical-align: middle;
    }

    .stats {
        font-family: var(--font-mono);
        white-space: nowrap;
    }

    @media (max-width: 520px) {
        .card-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 6px;
        }
    }
</style>
