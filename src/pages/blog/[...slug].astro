---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getReadingTime } from '../../utils/readingTime';
import { getLangFromUrl } from '../../i18n/utils';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			previousPost: posts[index + 1],
			nextPost: posts[index - 1],
		},
	}));
}
type Props = {
	post: CollectionEntry<'blog'>;
	previousPost?: CollectionEntry<'blog'>;
	nextPost?: CollectionEntry<'blog'>;
};

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const lang = getLangFromUrl(Astro.url);
const readingTime = getReadingTime(post.body || '', lang);
---

<PostLayout {...post.data} readingTime={readingTime} headings={headings} previousPost={previousPost} nextPost={nextPost}>
	<Content />
</PostLayout>
